# Copy this file to .env.local on your computer and fill in real values.
# Never commit .env.local. On Vercel, add the same names in the project's settings under
# Environments > Production (and Preview) > Environment Variables.
# Only names starting with NEXT_PUBLIC_ ever reach the browser, and they must never be secret.

# --- Phase 0 ---
# Claude (Anthropic). Server only. From platform.claude.com > API keys.
ANTHROPIC_API_KEY=
# Only needed when the key starts with sk-ant-usr (a personal key, not a workspace key):
# the workspace to use, from platform.claude.com > Settings > Workspaces (starts wrkspc_). Not secret.
ANTHROPIC_WORKSPACE_ID=
# Private code for the /health connection check. Any long random phrase you choose.
HEALTHCHECK_CODE=
# development | staging | production
APP_ENV=development

# --- Phase 1: Supabase (database, sign-in, files) ---
# Project URL and the publishable key (older projects call it the "anon" key).
# Not secret: the database's row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The site's own address, used in sign-in emails, e.g. https://lawdeck.vercel.app (no slash at the end).
SITE_URL=
# "true" shows "Continue with Google" once Google sign-in is set up in Google Cloud and Supabase.
GOOGLE_SIGN_IN_ENABLED=
# SECRET. Marked admin jobs only (src/server/db/admin.ts): writing search vectors (step 2d)
# and the retrieval test. Never used for students' requests. Supabase > Project Settings > API keys.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 2: Google Drive import for library files (admins). Not secret: the key only works
# on Lawdeck's address and the picker opens only the files an admin picks. The button appears
# once all three are set. Steps: docs/specs/library.md ("Drive import").
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# The Google Cloud project number (Dashboard > Project info).
NEXT_PUBLIC_GOOGLE_APP_ID=

# --- Phase 2: Voyage AI (library search). Server only. From dashboard.voyageai.com > API keys. ---
VOYAGE_API_KEY=

# --- Phase 7: Payments. Server only. ---
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Tests only. Never set these on Vercel. ---
# Turns on the export test's sample pages (/test-pages); without it they are "not found".
# LAWDECK_TEST_PAGES=1
# The explanations test (jobs/explain-eval.job.ts): which models and cases to run.
# EVAL_MODELS=
# EVAL_CASES=
