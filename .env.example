# Copy this file to .env.local on your computer and fill in real values.
# Never commit .env.local. On Vercel, add the same names under Settings > Environment Variables.
# Only names starting with NEXT_PUBLIC_ ever reach the browser, and they must never be secret.

# --- Phase 0 ---
# Claude (Anthropic). Server only. From platform.claude.com > API keys.
ANTHROPIC_API_KEY=
# Private code for the /health connection check. Any long random phrase you choose.
HEALTHCHECK_CODE=
# development | staging | production
APP_ENV=development

# --- Phase 1: Supabase (database, sign-in, files) ---
# From the Supabase project > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Admin background jobs only. Never used in normal requests.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 2: Voyage AI (library search). Server only. ---
VOYAGE_API_KEY=

# --- Phase 5: PDF converter. Server only. ---
PDF_SERVICE_URL=
PDF_SERVICE_TOKEN=

# --- Phase 7: Payments. Server only. ---
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
